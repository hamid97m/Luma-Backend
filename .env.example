NODE_ENV=development
PORT=3000
LOG_LEVEL=warn
# standby = API only (no webhook, jobs or bot DMs) — use on a new server before cutover. Unset/live = normal.
APP_MODE=
# Local Postgres (schema: pnpm db:migrate). Tests use their own Docker DB: pnpm test:db:up
DATABASE_URL=postgres://luma:luma@localhost:5432/luma
# Photo storage on local disk; public files are served at MEDIA_PUBLIC_URL (nginx in production)
MEDIA_DIR=./media
MEDIA_PUBLIC_URL=http://localhost:3000/media
# API's own public base URL: Telegram webhook (live mode) + signed upload/private-read links
PUBLIC_URL=http://localhost:3000
BOT_TOKEN=your-telegram-bot-token
WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
ADMIN_JWT_SECRET=change-me
# Optional. Telegram channel for purchase notices.
PAYMENT_NOTIFY_CHAT_ID=
BROADCAST_PREVIEW_CHAT_ID=
# Optional. Resolves the typed city to a hidden city/country for discovery ranking.
DEEPSEEK_API_KEY=
# Optional. Max DeepSeek calls per day (default 500 ≈ $0.04/day worst case).
DEEPSEEK_DAILY_LIMIT=
# Optional. "off" disables the AI review of men's main photo (on whenever DEEPSEEK_API_KEY is set).
PHOTO_AI_CHECK=
# Optional. Max photo reviews per day (default 1000 ≈ $0.30/day worst case).
PHOTO_CHECK_DAILY_LIMIT=
# Optional. TonPays card-to-card (paused by default).
TONPAYS_API_KEY=
TONPAYS_BASE_URL=
TONPAYS_CALLBACK_URL=
TONPAYS_WEBHOOK_SECRET=
TONPAYS_CHECKOUT_ENABLED=false
